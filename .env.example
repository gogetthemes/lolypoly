# Database
DATABASE_URL=sqlite:///./lolypoly.db
# DATABASE_URL=postgresql://user:password@localhost/lolypoly

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# WebSocket Settings
WS_TIMEOUT=30
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=5

# Pooymarket API
POOYMARKET_API_BASE_URL=https://api.pooymarket.com
POOYMARKET_WS_URL=wss://ws.pooymarket.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/lolypoly.log

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Bot Settings
CHECK_INTERVAL=5
MAX_CONCURRENT_TRADES=10
