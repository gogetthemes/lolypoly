# Переменные окружения для LolyPoly

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql://lolypoly:123456@localhost:5432/lolypoly

# Pooymarket API Configuration
POOYMARKET_API_BASE_URL=https://api.pooymarket.com
POOYMARKET_WS_URL=wss://ws.pooymarket.com

# WebSocket Configuration
WS_TIMEOUT=10
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=5

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/bot.log
